[gd_scene load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://assets/milk.png" id="1"]

[sub_resource type="RectangleShape2D" id="shape"]
size = Vector2(40, 52)

[sub_resource type="GDScript" id="script"]
script/source = "extends Area2D

## 漲停牛奶。從磚裡頂出來後停在磚上等人撿。
##
## 它不會自己走動也不會掉下去——玩家已經花了一次跳躍去頂那塊磚，
## 再讓道具跑掉只是懲罰他的好奇心。

const POP_HEIGHT := 64.0

func _ready() -> void:
	add_to_group(\"powerup\")
	var tween := create_tween()
	tween.tween_property(self, \"position:y\", position.y - POP_HEIGHT, 0.32) \\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	var bob := create_tween().set_loops()
	bob.tween_interval(0.32)
	bob.tween_property(self, \"scale\", Vector2(1.06, 0.94), 0.5) \\
		.set_trans(Tween.TRANS_SINE)
	bob.tween_property(self, \"scale\", Vector2(1.0, 1.0), 0.5) \\
		.set_trans(Tween.TRANS_SINE)
"

[node name="Powerup" type="Area2D"]
collision_layer = 16
collision_mask = 0
monitoring = false
script = SubResource("script")

[node name="Sprite" type="Sprite2D" parent="."]
texture = ExtResource("1")

[node name="Shape" type="CollisionShape2D" parent="."]
shape = SubResource("shape")
