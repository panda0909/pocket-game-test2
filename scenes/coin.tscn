[gd_scene load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://assets/coin.png" id="1"]

[sub_resource type="CircleShape2D" id="shape"]
radius = 20.0

[sub_resource type="GDScript" id="script"]
script/source = "extends Area2D

## 場上的金幣。只負責轉一圈給人看，撿取由玩家的 TouchBox 判定。

func _ready() -> void:
	add_to_group(\"coin\")
	var tween := create_tween().set_loops()
	tween.tween_property(self, \"scale:x\", 0.25, 0.6).set_trans(Tween.TRANS_SINE)
	tween.tween_property(self, \"scale:x\", 1.0, 0.6).set_trans(Tween.TRANS_SINE)
"

[node name="Coin" type="Area2D"]
collision_layer = 16
collision_mask = 0
monitoring = false
script = SubResource("script")

[node name="Sprite" type="Sprite2D" parent="."]
texture = ExtResource("1")

[node name="Shape" type="CollisionShape2D" parent="."]
shape = SubResource("shape")
