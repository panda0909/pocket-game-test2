; 口袋牛牛大冒險 — Godot 4.7 專案設定
;
; 與 Game2 不同之處：橫向 1280x720，且 stretch/aspect 用 keep 而非 expand。
; 平台遊戲的水平視野寬度必須固定，否則玩家看到的前方地形量會隨視窗大小
; 改變，等於難度跟著視窗浮動。

config_version=5

[application]

config/name="口袋牛牛大冒險"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/characters/red_bull.png"

; 載入畫面。不設的話用引擎預設，也就是 Godot 官方的機器人 logo——
; 而在 4G 上那是玩家看最久的一個畫面（10–40 秒），等於整個漏斗裡時間最長的
; 一格拿去幫別人的引擎打廣告。網頁匯出會把這張圖輸出成 index.png，
; HTML 殼在下載期間顯示的就是它。
boot_splash/bg_color=Color(0.055, 0.067, 0.09, 1)
boot_splash/image="res://assets/share_cover.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[audio]

buses/default_bus_layout="res://assets/default_bus_layout.tres"

[autoload]

Audio="*res://scenes/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194319,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":65,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":13,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"script":null)
]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194321,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":68,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":14,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"script":null)
]
}

duck={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194322,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":83,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":12,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0,"script":null)
]
}

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":87,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":4194320,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

throw={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":90,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
]
}

sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":10,"pressure":0.0,"pressed":false,"script":null)
]
}

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":80,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

; 關卡邊緣之外露出的區域用天空色填滿，才不會看到引擎預設的灰。
environment/defaults/default_clear_color=Color(0.494, 0.769, 0.933, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
